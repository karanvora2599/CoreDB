// TGQL (Temporal Graph Query Language) grammar. Patterns are (subject,
// predicate, object) triples where any position can be a literal or a
// `?var` wildcard. // starts a line comment.
//
// TGQL v0.1:
//   MATCH (SUBJECT, ?p, ?o) AS OF '2026-03-05' [KNOWN BY '2026-03-06T00:00:00']
//   HISTORY (SUBJECT, PREDICATE, ?o) [BETWEEN 'd1' AND 'd2']
//   DIFF BETWEEN 'd1' AND 'd2' [FOR (SUBJECT, ?p, ?o)]
//   RANGE (SUBJECT, PREDICATE, ?o) BETWEEN 'd1' AND 'd2'
//   SERIES (SUBJECT, PREDICATE, ?o) BETWEEN 'd1' AND 'd2' [RESOLUTION '7d']
//
// TGQL v0.2 additions:
//   ASSERT (SUBJECT, PREDICATE, OBJECT) VALID FROM 'date' [CONFIDENCE 0.9]
//   RETRACT (SUBJECT, PREDICATE, OBJECT) VALID TO 'date'
//   ... WHERE confidence > 0.5   (MATCH/HISTORY only)
//   ... LIMIT 10                (MATCH/HISTORY only, after WHERE)
//
// TGQL v0.3 additions:
//   TRACK DEGREE(NVIDIA) BETWEEN 'd1' AND 'd2' [RESOLUTION '7d']
//   TRACK WEIGHTED_DEGREE(NVIDIA) BETWEEN 'd1' AND 'd2'
//   TRACK EDGE_WEIGHT(SUBJECT, PREDICATE, OBJECT) BETWEEN 'd1' AND 'd2'
//
// TGQL v0.4 additions - point-to-point path queries (not general multi-hop
// pattern matching inside MATCH/HISTORY, which stays deferred):
//   PATH (A, B) AS OF 'date' [MAX_DEPTH 4]
//   FIRST_CONNECTED (A, B) [BETWEEN 'd1' AND 'd2'] [MAX_DEPTH 4]
//   PATH_HISTORY (A, B) BETWEEN 'd1' AND 'd2' [RESOLUTION '7d'] [MAX_DEPTH 4]

start: statement

statement: match_stmt
         | history_stmt
         | diff_stmt
         | range_stmt
         | series_stmt
         | assert_stmt
         | retract_stmt
         | track_stmt
         | path_stmt
         | first_connected_stmt
         | path_history_stmt

match_stmt: "MATCH"i pattern "AS"i "OF"i STRING ("KNOWN"i "BY"i STRING)? where_clause? limit_clause?
history_stmt: "HISTORY"i pattern ("BETWEEN"i STRING "AND"i STRING)? where_clause? limit_clause?
diff_stmt: "DIFF"i "BETWEEN"i STRING "AND"i STRING ("FOR"i pattern)?
range_stmt: "RANGE"i pattern "BETWEEN"i STRING "AND"i STRING
series_stmt: "SERIES"i pattern "BETWEEN"i STRING "AND"i STRING ("RESOLUTION"i STRING)?
assert_stmt: "ASSERT"i pattern "VALID"i "FROM"i STRING ("CONFIDENCE"i NUMBER)?
retract_stmt: "RETRACT"i pattern "VALID"i "TO"i STRING
track_stmt: "TRACK"i IDENTIFIER "(" IDENTIFIER ("," IDENTIFIER "," IDENTIFIER)? ")" "BETWEEN"i STRING "AND"i STRING ("RESOLUTION"i STRING)?
path_stmt: "PATH"i "(" IDENTIFIER "," IDENTIFIER ")" "AS"i "OF"i STRING max_depth_clause?
first_connected_stmt: "FIRST_CONNECTED"i "(" IDENTIFIER "," IDENTIFIER ")" ("BETWEEN"i STRING "AND"i STRING)? max_depth_clause?
path_history_stmt: "PATH_HISTORY"i "(" IDENTIFIER "," IDENTIFIER ")" "BETWEEN"i STRING "AND"i STRING ("RESOLUTION"i STRING)? max_depth_clause?

where_clause: "WHERE"i "confidence"i COMPARATOR NUMBER
limit_clause: "LIMIT"i NUMBER
max_depth_clause: "MAX_DEPTH"i NUMBER

pattern: "(" term "," term "," term ")"
term: VAR | IDENTIFIER

VAR: "?" IDENTIFIER
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
STRING: /'[^']*'/
NUMBER: /-?[0-9]+(\.[0-9]+)?/
COMPARATOR: />=|<=|!=|=|>|</

COMMENT: /\/\/[^\n]*/
%ignore COMMENT

%import common.WS
%ignore WS
